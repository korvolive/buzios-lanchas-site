# Segredos da função "conversoes" (rastreio server-side). Só os nomes: os valores ficam nos segredos das Edge Functions do Supabase
# (Painel do Supabase > Edge Functions > Secrets), nunca no código.

# Meta (Gerenciador de Eventos > fonte de dados do Pixel > Configurações)
META_PIXEL_ID=
# Meta: Configurações > API de Conversões > Gerar token de acesso
META_CAPI_TOKEN=
# Opcional, só durante o teste: Gerenciador de Eventos > Testar eventos > código (TEST...). Apagar depois do teste.
META_TEST_EVENT_CODE=
# Opcional (padrão v23.0)
META_GRAPH_VERSION=

# Google Analytics 4 (padrão G-NYEL6BGFBF)
GA4_MEASUREMENT_ID=
# GA4: Administrador > Fluxos de dados > Web > fluxo > Chaves secretas da API Measurement Protocol > Criar
GA4_API_SECRET=

# Opcional: 1 = não manda nada à Meta/Google, só grava no banco o que mandaria (modo de simulação)
RASTREIO_SIMULAR=
